# =============================================================
# finance-logger — Environment Variables
# Copy this file to .env in the project root and fill in values.
# chmod 600 .env
# =============================================================

# -------------------------------------------------------------
# Trading 212
# How to get: Log in to Trading 212 → Settings → API (beta)
#             Generate a key. Both values are shown on creation.
# -------------------------------------------------------------
T212_API_KEY=
T212_SECRET_KEY=

# Profit previously realised and re-invested into the ISA.
# Subtracted from T212 total_cost so the "deposits" cell reflects net new money in.
T212_ISA_CARRYOVER=0

# -------------------------------------------------------------
# Monzo OAuth (confidential client)
# How to get:
#   1. Go to https://developers.monzo.com
#   2. Sign in with your Monzo account
#   3. Click "New OAuth Client"
#   4. Set:
#        Name: finance-logger (or anything)
#        Logo: (leave blank)
#        Redirect URL: http://localhost:8080/callback
#        Client type: Confidential
#   5. Copy the Client ID and Client Secret below.
# -------------------------------------------------------------
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=
MONZO_REDIRECT_URI=http://localhost:8080/callback

# Set by bootstrap_monzo.py — leave blank until you run it.
MONZO_REFRESH_TOKEN=

# -------------------------------------------------------------
# Kraken
# How to get:
#   1. Log in to kraken.com
#   2. Go to Security → API
#   3. Click "Add key"
#   4. Under "Key Permissions", enable "Query Funds" plus, for the CGT
#      ledger, "Query Closed Orders & Trades" and "Query Ledger Entries"
#      (all read-only)
#   5. Copy the API Key and the Private Key shown on creation.
# -------------------------------------------------------------
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=

# -------------------------------------------------------------
# Coinbase (daily source + one-off backfill tools)
# cgt_ledger.py syncs Coinbase daily (on/after CGT_TAX_YEAR_START),
# alongside T212 + Kraken. src/coinbase_backfill.py additionally
# reconstructs the GBP cost basis of coins bought on Coinbase before
# CGT_TAX_YEAR_START (opening stubs), and cgt_ledger.py
# --backfill-history injects closed-year Coinbase disposals.
# How to get:
#   1. portal.cdp.coinbase.com → API keys → Create API key
#      (choose Ed25519 signature algorithm)
#   2. Grant View (read-only) permission only — no trade/transfer.
#   3. KEY_NAME is the full resource path organizations/<org>/apiKeys/<id>;
#      PRIVATE_KEY is the base64 secret shown once on creation.
# -------------------------------------------------------------
COINBASE_API_KEY_NAME=
COINBASE_API_PRIVATE_KEY=

# -------------------------------------------------------------
# Wise
# How to get: wise.com → Settings → Developer tools → API tokens
#             Create a token with Read scope.
# -------------------------------------------------------------
WISE_API_TOKEN=
# Profile ID: run the following after setting WISE_API_TOKEN:
#   curl -H "Authorization: Bearer <token>" https://api.wise.com/v1/profiles
#   Copy the "id" field for the entry with "type": "personal"
WISE_PROFILE_ID=

# -------------------------------------------------------------
# Gmail IMAP (for Barclaycard balance via auto-forwarded email)
# How to get:
#   1. Outlook → Rules → forward Barclaycard messages to your Gmail.
#   2. Gmail → Account → Security → 2-Step Verification → App passwords.
#      Create one named "finance-automation". Copy the 16-char password.
# -------------------------------------------------------------
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_APP_PASSWORD=
IMAP_FOLDER=Credit Card

# -------------------------------------------------------------
# Barclaycard
# Defaults match Barclaycard UK sender domain and a balance-themed subject.
# Override only if filtering is too narrow/broad.
# Set BARCLAYCARD_DEBUG=1 to print the full email body on every fetch.
# -------------------------------------------------------------
BARCLAYCARD_SENDER=barclaycard.co.uk
BARCLAYCARD_SUBJECT_KEYWORD=balance
# BARCLAYCARD_DEBUG=1

# -------------------------------------------------------------
# Google Sheets — service account
# Path to the service account JSON key file.
# The same key used by the Job Application Bot works here.
# -------------------------------------------------------------
GOOGLE_SA_KEY_PATH=/home/root/projects/Job Application Bot/config/service_account.json

# -------------------------------------------------------------
# Google Sheet details
# GOOGLE_SHEET_ID: the long ID in the sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART/edit
# GOOGLE_SHEET_TAB: the tab name (exactly as shown on the tab)
# -------------------------------------------------------------
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=
GOOGLE_MONZO_CELL=
GOOGLE_WISE_CELL=
GOOGLE_T212_ISA_CELL=
GOOGLE_T212_INVEST_VALUE_CELL=
GOOGLE_T212_ISA_DEPOSITS_CELL=
GOOGLE_KRAKEN_CELL=N11
GOOGLE_BARCLAYCARD_CELL=H5

# -------------------------------------------------------------
# CGT ledger (src/cgt_ledger.py)
# Tab name for the consolidated capital gains ledger, and the first
# day of the tax year to sync/backfill from (UK tax year start).
# CGT_LOSSES_BF (optional): unused capital losses from tax years before
# the ledger starts, carried into the first summary column (GBP, positive).
# -------------------------------------------------------------
CGT_SHEET_TAB=CGT Ledger
CGT_TAX_YEAR_START=2026-04-06
# CGT_LOSSES_BF=0

