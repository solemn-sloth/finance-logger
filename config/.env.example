# =============================================================
# finance-logger — Environment Variables
# Copy this file to .env in the project root and fill in values.
# chmod 600 .env
# =============================================================

# -------------------------------------------------------------
# Trading 212
# How to get: Log in to Trading 212 → Settings → API (beta)
#             Generate a key. Both values are shown on creation.
# -------------------------------------------------------------
T212_API_KEY=
T212_SECRET_KEY=

# -------------------------------------------------------------
# Monzo OAuth (confidential client)
# How to get:
#   1. Go to https://developers.monzo.com
#   2. Sign in with your Monzo account
#   3. Click "New OAuth Client"
#   4. Set:
#        Name: finance-logger (or anything)
#        Logo: (leave blank)
#        Redirect URL: http://localhost:8080/callback
#        Client type: Confidential
#   5. Copy the Client ID and Client Secret below.
# -------------------------------------------------------------
MONZO_CLIENT_ID=
MONZO_CLIENT_SECRET=
MONZO_REDIRECT_URI=http://localhost:8080/callback

# Set by bootstrap_monzo.py — leave blank until you run it.
MONZO_REFRESH_TOKEN=

# -------------------------------------------------------------
# Kraken
# How to get:
#   1. Log in to kraken.com
#   2. Go to Security → API
#   3. Click "Add key"
#   4. Under "Key Permissions", enable only "Query Funds" (read-only)
#   5. Copy the API Key and the Private Key shown on creation.
# -------------------------------------------------------------
KRAKEN_API_KEY=
KRAKEN_PRIVATE_KEY=

# -------------------------------------------------------------
# Wise
# How to get: wise.com → Settings → Developer tools → API tokens
#             Create a token with Read scope.
# -------------------------------------------------------------
WISE_API_TOKEN=
# Profile ID: run the following after setting WISE_API_TOKEN:
#   curl -H "Authorization: Bearer <token>" https://api.wise.com/v1/profiles
#   Copy the "id" field for the entry with "type": "personal"
WISE_PROFILE_ID=

# -------------------------------------------------------------
# Google Sheets — service account
# Path to the service account JSON key file.
# The same key used by the Job Application Bot works here.
# -------------------------------------------------------------
GOOGLE_SA_KEY_PATH=/home/root/projects/Job Application Bot/config/service_account.json

# -------------------------------------------------------------
# Google Sheet details
# GOOGLE_SHEET_ID: the long ID in the sheet URL:
#   https://docs.google.com/spreadsheets/d/THIS_PART/edit
# GOOGLE_SHEET_TAB: the tab name (exactly as shown on the tab)
# -------------------------------------------------------------
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=
GOOGLE_MONZO_CELL=
GOOGLE_WISE_CELL=
GOOGLE_T212_ISA_CELL=
GOOGLE_T212_INVEST_VALUE_CELL=
GOOGLE_T212_ISA_DEPOSITS_CELL=
GOOGLE_KRAKEN_CELL=N11

